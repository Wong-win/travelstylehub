---
/**
 * Emplacement publicitaire (Kwanko / Metaffiliation).
 *
 * La creative « display » du réseau est chargée comme une simple image dans
 * la page, et non dans une iframe. La requête porte l'identifiant de suivi,
 * elle vaut donc impression.
 *
 * Pourquoi pas d'iframe : Chrome classe les iframes de réseaux publicitaires
 * en « ad frame » et décharge ceux qui consomment trop de ressources
 * (« This ad used too many resources for your device, so Chrome removed it »).
 * Une image dans la page n'est jamais déchargée de la sorte, et la bannière
 * s'affiche à l'identique dans tous les navigateurs.
 *
 * Le src n'est posé qu'après consentement (src/lib/consent.ts) : aucun traceur
 * n'est déposé tant que l'internaute n'a pas accepté la publicité. Le repli
 * <noscript> est volontairement absent — sans JavaScript aucun consentement
 * ne peut être recueilli, il donc chargerait un traceur sans accord.
 *
 * Le libellé « Advertisement » est exigé par la politique de confidentialité
 * (« their presence is labelled "Advertisement" »).
 */
interface Props {
  /** URL « display » du réseau : l'identifiant P de l'emplacement. */
  image: string;
  /** URL « click » du réseau : l'identifiant P du lien de suivi. */
  click: string;
  width?: number;
  height?: number;
  alt?: string;
}

const { image, click, width = 728, height = 90, alt = "" } = Astro.props;
---

<div class="ad-slot" data-ad-banner hidden>
  <span class="ad-slot__label">Advertisement</span>
  <a class="ad-slot__link" href={click} target="_blank" rel="sponsored noopener noreferrer">
    <img
      class="ad-slot__img"
      data-ad-image={image}
      width={width}
      height={height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </a>
</div>

<style>
  .ad-slot {
    width: min(1250px, 100%);
    margin: 0 auto 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Rien n'est montré avant le consentement : ni le libellé, ni une image
     vide. L'attribut hidden est neutralisé par le display:flex ci-dessus,
     il faut donc le réaffirmer explicitement. */
  .ad-slot[hidden] {
    display: none;
  }

  .ad-slot__label {
    margin-bottom: 6px;
    color: var(--hp-text-muted, #777777);
    font: 700 10px/1 "Roboto", Arial, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ad-slot__link {
    display: block;
    width: 100%;
    max-width: 728px;
    line-height: 0;
  }

  /* La bannière fait 728 px de large : sur les écrans étroits elle est
     réduite à la largeur disponible plutôt que d'être rognée. */
  .ad-slot__img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .ad-slot {
      margin-bottom: 16px;
    }
  }
</style>
