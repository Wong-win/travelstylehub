---
import { siteInfo } from "../data/site-info";

const adNames = siteInfo.adNetworks.map((n) => n.name).join(", ");
const prefix = "tsh";
---

<div id="tsh-cc" class="tsh-cc" hidden>
  <div class="tsh-cc__box" role="dialog" aria-modal="false" aria-label="Cookie preferences">
    <p class="tsh-cc__text">
      <strong>This site uses cookies.</strong>
      Cookies required for the site to work are always on, and {siteInfo.analytics.provider} measures the audience of the site. Advertising banners from our affiliate partners ({adNames}) are displayed on every visit: loading them sets impression-tracking and click-tracking cookies. Cloudflare measures traffic anonymously, without cookies or advertising identifiers.
      <a href="/privacy-policy/">Privacy Policy</a>
    </p>
    <div class="tsh-cc__actions">
      <button type="button" class="tsh-cc__btn" data-action="ok">Got it</button>
    </div>
  </div>
</div>

  <style>
  .tsh-cc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    font-family: inherit;
  }
  .tsh-cc[hidden] {
    display: none;
  }
  .tsh-cc__box,
  .tsh-cc__panel {
    background: #141414;
    color: #ecebe7;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .tsh-cc__box {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.1rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .tsh-cc__text {
    flex: 1 1 460px;
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0;
    color: #b6b3ae;
  }
  .tsh-cc__text strong {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.88rem;
    color: #fff;
  }
  .tsh-cc__text a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tsh-cc__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  /* Refuse and Accept: same size, same weight, same number of clicks. */
  .tsh-cc__btn {
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 3px;
    padding: 0.6rem 1.15rem;
    cursor: pointer;
    min-width: 110px;
    transition: background 0.15s, border-color 0.15s;
  }
  .tsh-cc__btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.75);
  }
  .tsh-cc__link {
    font-family: inherit;
    font-size: 0.8rem;
    color: #b6b3ae;
    background: none;
    border: 0;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    text-decoration: underline;
  }
  .tsh-cc__link:hover {
    color: #fff;
  }
  .tsh-cc__panel {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 1rem 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .tsh-cc__panel[hidden] {
    display: none;
  }
  .tsh-cc__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.9rem;
  }
  .tsh-cc__list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .tsh-cc__label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
  }
  .tsh-cc__label input {
    width: 16px;
    height: 16px;
    cursor: pointer;
  }
  .tsh-cc__label input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .tsh-cc__desc {
    font-size: 0.78rem;
    line-height: 1.5;
    color: #9b9892;
    margin: 0.25rem 0 0 1.65rem;
  }
  @media (max-width: 640px) {
    .tsh-cc__box {
      flex-direction: column;
      align-items: stretch;
    }
    .tsh-cc__actions {
      justify-content: stretch;
    }
    .tsh-cc__btn {
      flex: 1;
    }
  }
</style>

<script>
  const root = document.getElementById("tsh-cc");
  if (root && window.TSH_CONSENT) {
    const show = () => { root.hidden = false; };
    const hide = () => { root.hidden = true; };

    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.getAttribute("data-action") !== "ok") return;
      window.TSH_CONSENT.set({ necessary: true, analytics: true, advertising: true, ts: Date.now() });
      hide();
    });

    // API exposée pour le pied de page (« Gérer les cookies »).
    window.TSH_CONSENT.openPreferences = show;

    if (!window.TSH_CONSENT.get()) show();
  }
</script>
