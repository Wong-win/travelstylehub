---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import { siteInfo } from "../data/site-info";
import { consentScript } from "../lib/consent";

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const siteTitle = title
  ? `${title} - Travel Style Hub`
  : "Travel Style Hub - Travel inspiration, destinations, aviation, fashion and food";
const siteDescription =
  description ||
  "Travel inspiration, destinations, aviation, fashion and food.";
const consentMaxAge = String(siteInfo.consent.maxAgeDays * 24 * 3600 * 1000);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="canonical" href={new URL(Astro.url.pathname, `https://www.travelstylehub.com`)} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
      
    

    <!--
      Audience measurement and advertising are only loaded after explicit
      consent. Nothing is tracked before the visitor has chosen.
    -->
    <meta name="tsh-ga-id" content={siteInfo.analytics.id} />
    <meta name="tsh-consent-key" content={siteInfo.consent.storageKey} />
    <meta name="tsh-consent-max-age" content={consentMaxAge} />
    <script is:inline set:html={consentScript} />

  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  <CookieConsent /></body>
</html>
