---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { decodeEntities } from "../utils/decode-entities";

const articles = (await getCollection("articles")).sort((a, b) => {
  const ap = a.data.pinned ? 1 : 0; const bp = b.data.pinned ? 1 : 0;
  if (ap !== bp) return bp - ap;
  return b.data.date.localeCompare(a.data.date);
});
type Article = (typeof articles)[number];

const byCategory = (category: string) => articles.filter((article) => article.data.category === category);
const articleUrl = (article: Article) =>
  `/${article.data.year}/${article.data.month}/${article.data.day}/${article.slug}`;
const articleImage = (article: Article) =>
  article.data.image || `https://picsum.photos/seed/${article.slug}/900/600`;
const articleTitle = (article: Article) => decodeEntities(article.data.title);
const articleExcerpt = (article: Article) => decodeEntities(article.data.excerpt || "");
const dateLabel = (article: Article) =>
  new Date(article.data.date).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });

const featured = articles.slice(0, 5);
const recent = articles.slice(5, 11);
const fashion = byCategory("fashion").slice(0, 6);
const food = byCategory("food").slice(0, 5);
const destinations = byCategory("destinations").slice(0, 5);
const aviation = byCategory("aviation").slice(0, 4);
const popular = [aviation[0], food[0], fashion[0], destinations[0], aviation[1], food[1], fashion[1]].filter(Boolean);
const latest = articles.slice(10, 18);
---

<Layout>
  <div class="home-page">
    <section class="front-grid" aria-label="Featured stories">
      <div class="front-main">
        <div class="feature-grid">
          {featured.slice(0, 2).map((article) => (
            <a class="feature-card feature-card--wide" href={articleUrl(article)}>
              <img fetchpriority="high" loading="eager" decoding="sync" src={articleImage(article)} alt="" />
              <div class="feature-copy">
                <h2>{articleTitle(article)}</h2>
                <time datetime={article.data.date}>{dateLabel(article)}</time>
              </div>
            </a>
          ))}
          {featured.slice(2).map((article) => (
            <a class="feature-card" href={articleUrl(article)}>
              <img loading="eager" decoding="sync" src={articleImage(article)} alt="" />
              <div class="feature-copy">
                <h2>{articleTitle(article)}</h2>
                <time datetime={article.data.date}>{dateLabel(article)}</time>
              </div>
            </a>
          ))}
        </div>

        <div class="editorial-grid">
          <aside class="left-rail">
            <a class="destination-promo" href="/destinations">
              <img loading="lazy" decoding="async" src="/wp-content/uploads/2023/12/shutterstockRF1034336518.avif" alt="Travel destination" />
            </a>

            <section class="panel">
              <header class="section-heading"><h2>Destinations</h2></header>
              {destinations.map((article) => (
                <a class="rail-row" href={articleUrl(article)}>
                  <img loading="lazy" decoding="async" src={articleImage(article)} alt="" />
                  <div>
                    <h3>{articleTitle(article)}</h3>
                    <time datetime={article.data.date}>{dateLabel(article)}</time>
                  </div>
                </a>
              ))}
            </section>
          </aside>

          <div class="center-column">
            <section class="panel">
              <header class="section-heading"><h2>Fashion</h2></header>
              <div class="fashion-layout">
                <div class="fashion-visuals">
                  <a class="fashion-lead" href={articleUrl(fashion[0])}>
                    <img loading="lazy" decoding="async" src={articleImage(fashion[0])} alt="" />
                    <h3>{articleTitle(fashion[0])}</h3>
                  </a>
                  <div class="fashion-thumbs">
                    {fashion.slice(1, 3).map((article) => (
                      <a href={articleUrl(article)}>
                        <img loading="lazy" decoding="async" src={articleImage(article)} alt="" />
                        <h3>{articleTitle(article)}</h3>
                      </a>
                    ))}
                  </div>
                </div>
                <div class="fashion-links">
                  {fashion.slice(3, 8).map((article) => (
                    <a href={articleUrl(article)}>
                      <h3>{articleTitle(article)}</h3>
                      <time datetime={article.data.date}>{dateLabel(article)}</time>
                    </a>
                  ))}
                </div>
              </div>
            </section>

            <section class="panel">
              <header class="section-heading">
                <h2>Food</h2>
                <a href="/food">View all</a>
              </header>
              <div class="food-layout">
                <a class="food-lead" href={articleUrl(food[0])}>
                  <img loading="lazy" decoding="async" src={articleImage(food[0])} alt="" />
                  <h3>{articleTitle(food[0])}</h3>
                </a>
                <div class="food-list">
                  {food.slice(1, 5).map((article) => (
                    <a href={articleUrl(article)}>
                      <img loading="lazy" decoding="async" src={articleImage(article)} alt="" />
                      <h3>{articleTitle(article)}</h3>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>

      <aside class="right-rail">
        <section class="recent-panel panel">
          <header class="section-heading"><h2>Recent Posts</h2></header>
          <a class="recent-lead" href={articleUrl(recent[0])}>
            <img loading="lazy" decoding="async" src={articleImage(recent[0])} alt="" />
            <h3>{articleTitle(recent[0])}</h3>
            <time datetime={recent[0].data.date}>{dateLabel(recent[0])}</time>
          </a>
          {recent.slice(1).map((article) => (
            <a class="recent-row" href={articleUrl(article)}>
              <img loading="lazy" decoding="async" src={articleImage(article)} alt="" />
              <div>
                <h3>{articleTitle(article)}</h3>
                <time datetime={article.data.date}>{dateLabel(article)}</time>
              </div>
            </a>
          ))}
        </section>
        <a class="sidebar-feature" href={articleUrl(destinations[0])}>
          <img loading="lazy" decoding="async" src={articleImage(destinations[0])} alt="" />
          <div><span>Editor’s pick</span><h3>{articleTitle(destinations[0])}</h3></div>
        </a>
      </aside>
    </section>

    <section class="wide-section aviation-section">
      <header class="section-heading section-heading--wide">
        <h2>Aviation</h2>
        <a href="/aviation">View all</a>
      </header>
      <div class="aviation-grid">
        {aviation.map((article) => (
          <a class="aviation-card" href={articleUrl(article)}>
            <img loading="lazy" decoding="async" src={articleImage(article)} alt="" />
            <span>Aviation</span>
            <h3>{articleTitle(article)}</h3>
            <time datetime={article.data.date}>{dateLabel(article)}</time>
          </a>
        ))}
      </div>
    </section>

    <section class="lower-grid">
      <aside class="popular-panel panel">
        <header class="section-heading"><h2>Popular Posts</h2></header>
        {popular.map((article, index) => (
          <a class="popular-row" href={articleUrl(article)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{articleTitle(article)}</h3>
              <time datetime={article.data.date}>{dateLabel(article)}</time>
            </div>
          </a>
        ))}
      </aside>

      <div class="latest-panel panel">
        <header class="section-heading"><h2>Latest News</h2></header>
        <div class="latest-list">
          {latest.map((article) => (
            <article class="latest-row">
              <a href={articleUrl(article)}><img loading="lazy" decoding="async" src={articleImage(article)} alt="" /></a>
              <div>
                <span>{article.data.category}</span>
                <h3><a href={articleUrl(article)}>{articleTitle(article)}</a></h3>
                <time datetime={article.data.date}>{dateLabel(article)}</time>
                <p>{articleExcerpt(article)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===== CSS Custom Properties ===== */
  :root {
    --hp-gap-xs: 6px;
    --hp-gap-sm: 16px;
    --hp-gap-md: 24px;
    --hp-accent: #00a651;
    --hp-accent-deep: #008c44;
    --hp-bg: #f1f1f1;
    --hp-card: #ffffff;
    --hp-text: #111111;
    --hp-text-muted: #777777;
    --hp-border: #e8e8e8;
  }

  :global(body) {
    background: var(--hp-bg);
    color: var(--hp-text);
    font-family: "Roboto", "Helvetica Neue", Arial, sans-serif;
  }

  /* ===== Page Container ===== */

  .home-page {
    padding: var(--hp-gap-md) var(--hp-gap-sm) 64px;
  }

  .front-grid,
  .wide-section,
  .lower-grid {
    width: min(1250px, 100%);
    margin-inline: auto;
  }

  /* ===== Section Heading ===== */

  .section-heading {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .section-heading::after {
    content: "";
    height: 3px;
    flex: 1;
    background: #eaeaea;
  }

  .section-heading h2 {
    flex: none;
    margin: 0;
    color: var(--hp-text);
    font: 600 21px/1 "Oswald", "Arial Narrow", Arial, sans-serif;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .section-heading > a {
    order: 2;
    flex: none;
    color: var(--hp-text-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .section-heading > a:hover {
    color: var(--hp-accent);
  }

  .section-heading:has(> a)::after {
    order: 1;
  }

  /* ===== Panel (white card container) ===== */

  .panel {
    background: var(--hp-card);
    padding: 24px;
  }

  /* ===== 1. Feature Grid ===== */

  .front-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--hp-gap-md);
    align-items: start;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--hp-gap-xs);
  }

  .feature-card {
    position: relative;
    grid-column: span 2;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #171717;
    color: #fff;
  }

  .feature-card--wide {
    grid-column: span 3;
  }

  .feature-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .feature-card:hover img {
    transform: scale(1.04);
  }

  .feature-card::after {
    content: "";
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }

  .feature-copy {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    padding: 20px 22px;
  }

  .feature-copy h2 {
    margin: 0 0 8px;
    color: #fff;
    font: 700 20px/1.25 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feature-card--wide .feature-copy h2 {
    font-size: 24px;
  }

  .home-page time {
    color: var(--hp-text-muted);
    font-size: 11px;
  }

  .feature-copy time {
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
  }

  /* ===== 2. Editorial Grid (Left Rail + Center) ===== */

  .editorial-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--hp-gap-md);
    margin-top: var(--hp-gap-md);
  }

  /* Left Rail */

  .destination-promo {
    display: block;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--hp-gap-md);
    overflow: hidden;
  }

  .destination-promo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rail-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 14px;
    padding: 0 0 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--hp-border);
  }

  .rail-row:last-child {
    margin-bottom: 0;
  }

  .rail-row img {
    width: 100px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .rail-row h3 {
    margin: 0 0 6px;
    font: 700 13px/1.3 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Center Column */

  .center-column {
    display: grid;
    gap: var(--hp-gap-md);
  }

  /* Fashion Block */

  .fashion-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--hp-gap-sm);
    align-items: start;
  }

  .fashion-visuals {
    display: flex;
    flex-direction: column;
    gap: var(--hp-gap-xs);
  }

  .fashion-lead {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    color: #fff;
  }

  .fashion-lead img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .fashion-lead:hover img {
    transform: scale(1.03);
  }

  .fashion-lead::after {
    content: "";
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }

  .fashion-lead h3 {
    position: absolute;
    z-index: 1;
    right: 18px;
    bottom: 18px;
    left: 18px;
    margin: 0;
    color: #fff;
    font: 700 20px/1.2 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fashion-thumbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--hp-gap-xs);
  }

  .fashion-thumbs a {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    color: #fff;
  }

  .fashion-thumbs a::after {
    content: "";
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }

  .fashion-thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fashion-thumbs h3 {
    position: absolute;
    z-index: 1;
    right: 12px;
    bottom: 12px;
    left: 12px;
    margin: 0;
    color: #fff;
    font: 700 14px/1.25 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fashion-links {
    display: flex;
    flex-direction: column;
  }

  .fashion-links a {
    display: block;
    padding: 13px 0;
    border-bottom: 1px solid var(--hp-border);
    transition: color 0.2s;
  }

  .fashion-links a:first-child {
    padding-top: 0;
  }

  .fashion-links a:last-child {
    border-bottom: none;
  }

  .fashion-links h3 {
    margin: 0 0 6px;
    font: 700 14px/1.3 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Food Block */

  .food-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--hp-gap-sm);
  }

  .food-lead {
    grid-column: 1 / -1;
    display: block;
  }

  .food-lead img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .food-lead h3 {
    margin: 0;
    font: 700 20px/1.3 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .food-list {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--hp-gap-sm);
  }

  .food-list a {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 14px;
    align-items: start;
  }

  .food-list img {
    width: 100px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .food-list h3 {
    margin: 0;
    font: 700 13px/1.3 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 3. Right Rail ===== */

  .right-rail {
    display: grid;
    gap: var(--hp-gap-md);
    align-content: start;
  }

  .recent-lead {
    display: block;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--hp-border);
  }

  .recent-lead img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 14px;
  }

  .recent-lead h3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 8px;
    font: 700 18px/1.25 "Roboto", Arial, sans-serif;
  }

  .recent-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hp-border);
  }

  .recent-row:last-child {
    border-bottom: none;
  }

  .recent-row img {
    width: 100px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .recent-row h3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 6px;
    font: 700 13px/1.3 "Roboto", Arial, sans-serif;
  }

  .sidebar-feature {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    color: #fff;
  }

  .sidebar-feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-feature::after {
    content: "";
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }

  .sidebar-feature > div {
    position: absolute;
    z-index: 1;
    right: 18px;
    bottom: 18px;
    left: 18px;
  }

  .sidebar-feature span {
    display: block;
    margin-bottom: 6px;
    color: #8ee0aa;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sidebar-feature h3 {
    margin: 0;
    color: #fff;
    font: 700 18px/1.25 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 4. Aviation Strip ===== */

  .wide-section {
    margin-top: var(--hp-gap-md);
    padding: 28px 24px;
    background: var(--hp-card);
  }

  .section-heading--wide {
    margin-bottom: 20px;
  }

  .aviation-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--hp-gap-md);
  }

  .aviation-card {
    display: block;
  }

  .aviation-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 12px;
    transition: opacity 0.3s;
  }

  .aviation-card:hover img {
    opacity: 0.85;
  }

  .aviation-card > span {
    color: var(--hp-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .aviation-card h3 {
    margin: 6px 0 8px;
    font: 700 17px/1.3 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 5. Lower Grid ===== */

  .lower-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--hp-gap-md);
    margin-top: var(--hp-gap-md);
    align-items: start;
  }

  .popular-row {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hp-border);
  }

  .popular-row:last-child {
    border-bottom: none;
  }

  .popular-row > span {
    color: var(--hp-accent);
    font: 600 28px/1 "Oswald", Arial, sans-serif;
  }

  .popular-row h3 {
    margin: 0 0 6px;
    font: 700 13px/1.3 "Roboto", Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .latest-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--hp-gap-md);
  }

  .latest-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
    padding: 0 0 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--hp-border);
  }

  .latest-row img {
    width: 140px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .latest-row > div > span {
    color: var(--hp-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .latest-row h3 {
    margin: 5px 0 7px;
    font: 700 16px/1.3 "Roboto", Arial, sans-serif;
  }

  .latest-row p {
    margin: 0;
    color: var(--hp-text-muted);
    font-size: 13px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== Responsive ===== */

  @media (max-width: 1024px) {
    .front-grid {
      grid-template-columns: 1fr;
    }

    .right-rail {
      grid-template-columns: repeat(2, 1fr);
    }

    .sidebar-feature {
      aspect-ratio: 16 / 9;
    }

    .editorial-grid {
      grid-template-columns: 240px minmax(0, 1fr);
    }

    .fashion-layout,
    .food-layout {
      grid-template-columns: 1fr;
    }

    .fashion-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--hp-gap-sm);
    }

    .food-list {
      grid-template-columns: 1fr;
    }

  @media (max-width: 768px) {
    .home-page {
      padding: var(--hp-gap-sm) 12px 48px;
